# ============================
# .gitignore — Cancha Gremio
# ============================

# -------------------- Backend (Python / FastAPI) --------------------
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# -------------------- Frontend (Node.js / React / Vite) --------------------
node_modules/
dist/
build/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------- PHP / Dependencias --------------------
vendor/

# -------------------- Variables de entorno --------------------
.env
.env.local
.env.*.local
BE/.env
FE/.env

# -------------------- Base de datos / migraciones locales --------------------
*.sqlite3
*.db

# -------------------- Archivos del sistema --------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# -------------------- Editores de código --------------------
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# -------------------- Pruebas y cobertura --------------------
coverage/
.nyc_output/
*.lcov
htmlcov/

# -------------------- Logs --------------------
logs/
*.log

# -------------------- Docker --------------------
docker-compose.override.yml

# -------------------- Legado y temporales --------------------
supabase/
script.js
~$*